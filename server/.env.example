# Copy file này thành server/.env rồi điền giá trị. KHÔNG commit file .env lên GitHub.

# Mật khẩu vào trang /admin (dev để trống thì mặc định là "admin")
ADMIN_PASSWORD=

# Supabase → Project Settings → API (để trống cả 2 thì lưu cục bộ trong server/.local-data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# Tốc độ đọc, vd: -10% (chậm hơn một chút cho bé), 0%, +10%
TTS_RATE=-10%
